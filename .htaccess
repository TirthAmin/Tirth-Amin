# ============================================================
# AMIN REALTY, INC. — Apache config for GoDaddy shared hosting
# Upload this file to the same folder as index.html (public_html).
# Every block is wrapped in <IfModule> so nothing breaks if a
# module is unavailable on your plan.
# ============================================================

# ---- Always serve the branded 404 page ----
ErrorDocument 404 /404.html

# ---- Force HTTPS and the non-www domain (matches the site's canonical URL) ----
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>

# ---- Compress text assets (HTML/CSS/JS/SVG/JSON) ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

# ---- Correct types for the self-hosted fonts ----
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

# ---- Browser caching: long for fonts, medium for scripts/styles ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  # HTML always revalidates so edits show up immediately
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ---- Sensible security headers ----
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
